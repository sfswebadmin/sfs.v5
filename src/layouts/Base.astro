---
import Header from '../components/Header.astro';
import Nav from '../components/Nav.astro';
import Sponsors from '../components/Sponsors.astro';
import Footer from '../components/Footer.astro';

const { title, description, keywords } = Astro.props;
---

<!doctype html>
<html lang='en'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />

    <title>SFS - {title}</title>

    <meta name='description' content={description} />
    <meta name='keywords' content={keywords} />
    <meta name='author' content='Swindon Film Society' />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-55TGQTV');
    </script>
    <!-- End Google Tag Manager -->

    <link rel='icon' type='image/x-icon' href='/img/sfs.ico' />

    <!-- Latest compiled and minified CSS -->
    <link rel='stylesheet' href='/css/bootstrap.min.css' />
    <link rel='stylesheet' href='/css/font-awesome.min.css' />
    <link href='//cdn-images.mailchimp.com/embedcode/classic-061523.css' rel='stylesheet' type='text/css' />
    <style lang='scss'></style>
  </head>

  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe src='https://www.googletagmanager.com/ns.html?id=GTM-55TGQTV' height='0' width='0' style='display:none;visibility:hidden'
      ></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->

    <Header />

    <Nav />

    <main>
      <div class='container'>
        <div class='row'>
          <slot />
        </div>
      </div>
    </main>

    <Sponsors />

    <Footer />

    <script src='/js/bootstrap.min.js' is:inline></script>
  </body>
</html>

<style is:global>
  :root {
    --base-color: #3b52a0;

    --primary-bg: var(--base-color);
    --primary-clr: var(--base-color);

    --clr-neutral-100: #ffffff;
    --clr-neutral-200: #f8f8f8;
    --clr-neutral-300: #e7e7e7;
    --clr-neutral-400: #808080;
    --clr-neutral-600: #595959;
    --clr-neutral-800: #282727;
    --clr-neutral-900: #000000;

    --clr-blue-400: #4169e1;

    --poster-box-bg: var(--clr-neutral-200);

    --membership-box-bg: color-mix(in srgb, var(--primary-bg) 70%, white);

    --navbar-hover: #5779e7;
    --navbar-active: #263566;
    --navbar-border-clr: color-mix(in srgb, var(--primary-bg) 80%, black);

    /* all main buttons */
    --btn-primary-bg: #ffc107;
    --btn-primary-clr: var(--clr-neutral-900);
    --btn-primary-bg-hover: #f8ce52;
    --btn-primary-clr-hover: var(--clr-neutral-900);

    /* ticket buttons */
    --btn-secondary-bg: var(--primary-bg);
    --btn-secondary-clr: var(--clr-neutral-100);
    --btn-secondary-bg-hover: color-mix(in srgb, var(--primary-bg) 50%, white);
    --btn-secondary-clr-hover: var(--clr-neutral-100);

    /* membership homepage cta button */
    --btn-tertiary-bg: color-mix(in srgb, var(--primary-bg) 70%, black);
    --btn-tertiary-clr: var(--clr-neutral-100);
    --btn-tertiary-bg-hover: color-mix(in srgb, var(--primary-bg) 30%, white);
    --btn-tertiary-clr-hover: var(--clr-neutral-900);

    /* Sponsors */
    --sponsor-background: var(--clr-blue-400);
    --sponsor-text-color: var(--clr-neutral-200);
    --sponsor-section-border: color-mix(in srgb, var(--clr-blue-400) 50%, black);

    /* Fonts */
    --ff-primary:
      system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Sans', 'Liberation Sans', Arial, sans-serif, 'Apple Color Emoji',
      'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji';

    --fw-200: 200;
    --fw-400: 400;
    --fw-600: 600;
    --fw-700: 700;
  }

  body {
    font-family: var(--ff-primary);
    font-weight: var(--fw-400);

    background: var(--clr-neutral-100);
    color: var(--clr-neutral-900);
  }

  main {
    margin-block: 3rem;
  }

  a {
    color: var(--primary-clr);
  }

  blockquote {
    border-left: none;
    font-size: 1.2em;
  }

  .btn-agm-reports {
    background-color: #3b52a0;
  }

  .btn-agm-reports:hover,
  .btn-agm-reports:focus {
    background-color: #5779e7;
  }

  .table {
    border: 1px solid var(--clr-neutral-900);
    margin-bottom: 10px;

    & > :not(caption) > * > * {
      background-color: var(--primary-bg);
    }

    & thead tr th,
    & tbody tr td {
      padding: 7px;
      border: 1px solid var(--clr-neutral-900);
    }

    & thead tr th {
      background-color: var(--primary-clr);
      color: var(--clr-neutral-100);
    }

    & tbody tr td {
      background-color: var(--clr-neutral-100);
      color: var(--clr-neutral-900);
    }

    & tfoot tr td {
      background: none;
      font-weight: var(--fw-600);
    }
  }

  .btn-normal {
    background-color: var(--btn-primary-bg);
    color: var(--btn-primary-clr);
  }

  .btn-normal:hover,
  .btn-normal:focus,
  .btn-normal:active {
    background-color: var(--btn-primary-bg-hover);
    color: var(--btn-primary-clr-hover);
  }

  .btn-tickets {
    background-color: var(--btn-secondary-bg);
    border-color: var(--btn-secondary-bg);
    color: var(--btn-secondary-clr);
  }

  .btn-tickets:hover,
  .btn-tickets:focus,
  .btn-tickets:active {
    background-color: var(--btn-secondary-bg-hover);
    color: var(--btn-secondary-clr-hover);
  }

  .btn-membership {
    background-color: var(--btn-tertiary-bg);
    color: var(--btn-tertiary-clr);
    transition: all 0.4s ease;
  }

  .btn-membership:hover,
  .btn-membership:focus,
  .btn-membership:active {
    background-color: var(--btn-tertiary-bg-hover);
    color: var(--btn-tertiary-clr-hover);
  }

  .membership-box-button a:focus,
  .membership-box-button a:hover {
    text-decoration: none;
  }

  .front-page-buttons a,
  .front-page-buttons button {
    margin-top: 5px;
  }
</style>
